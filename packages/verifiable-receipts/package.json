{
  "name": "@sovereign-matrix/verifiable-receipts",
  "version": "0.4.0",
  "description": "Sign receipts for AI agent actions and verify them later: Ed25519 and ML-DSA-65 signatures, an RFC 9162 Merkle transparency log, m-of-n co-signing, stream attestation and signed ZIP bundles.",
  "license": "Apache-2.0",
  "author": "Christiaan de Wet <sovereign.systems007@gmail.com>",
  "homepage": "https://github.com/christiaan839-beep/verifiable-receipts/tree/main/packages/verifiable-receipts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christiaan839-beep/verifiable-receipts.git",
    "directory": "packages/verifiable-receipts"
  },
  "bugs": "https://github.com/christiaan839-beep/verifiable-receipts/issues",
  "keywords": [
    "receipts",
    "signatures",
    "ed25519",
    "ml-dsa",
    "fips-204",
    "merkle-tree",
    "transparency-log",
    "rfc9162",
    "ai-agents"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "verifiable-receipts": "./bin/verify.mjs",
    "verifiable-receipts-witness": "./bin/witness.mjs",
    "verifiable-receipts-sign": "./bin/sign.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pq-sign": {
      "types": "./dist/pq-sign.d.ts",
      "import": "./dist/pq-sign.js"
    },
    "./guardian": {
      "types": "./dist/guardian.d.ts",
      "import": "./dist/guardian.js"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "import": "./dist/bundle.js"
    },
    "./transparency": {
      "types": "./dist/transparency.d.ts",
      "import": "./dist/transparency.js"
    },
    "./log-store": {
      "types": "./dist/log-store.d.ts",
      "import": "./dist/log-store.js"
    },
    "./threshold": {
      "types": "./dist/threshold.d.ts",
      "import": "./dist/threshold.js"
    },
    "./stream-attestation": {
      "types": "./dist/stream-attestation.d.ts",
      "import": "./dist/stream-attestation.js"
    },
    "./vapt": {
      "types": "./dist/vapt.d.ts",
      "import": "./dist/vapt.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "SPEC.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "prepare": "node -e \"if(!require('node:fs').existsSync('dist'))require('node:child_process').execSync('tsc -p tsconfig.json',{stdio:'inherit'})\"",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "fast-check": "4.10.2",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
